# NyxCitadel Environment Variables
# Copy this file to .env.local (local dev) or set these in your hosting provider dashboard.
# Never commit .env.local or .env to source control.

# ─────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────
# Option A - Prisma Accelerate (prisma.io managed)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_ACCELERATE_API_KEY"

# Option B - Direct Postgres (Vercel Postgres, Supabase, Neon, Railway, or self-hosted)
# Pooled connection - used by Prisma at runtime (serverless environments)
# POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/nyxcitadel?pgbouncer=true&connect_timeout=15"
# Direct connection - used by Prisma for migrations only
# POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/nyxcitadel"

# Option C - Local Postgres dev
# DATABASE_URL="postgresql://postgres:password@localhost:5432/nyxcitadel"

# ─────────────────────────────────────────────────────────
# NEXTAUTH
# Generate secret with: openssl rand -base64 32
# ─────────────────────────────────────────────────────────
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# ─────────────────────────────────────────────────────────
# AI ASSISTANT (REQUIRED for NyxAI compliance assistant)
# Get key at: https://console.anthropic.com/settings/keys
# Uses claude-3-5-haiku-20241022 by default
# ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─────────────────────────────────────────────────────────
# AUTOMATED REGULATORY SCRAPER (REQUIRED for daily cron)
# Generate with: openssl rand -hex 32
# Must also be set in Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────
CRON_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# ─────────────────────────────────────────────────────────
# CLEAN SEED OVERRIDES (used by: npm run db:seed:clean)
# Leave unset to use defaults (admin@example.com / ChangeMe123!)
# ─────────────────────────────────────────────────────────
# SEED_FACILITY_NAME="My Healthcare Facility"
# SEED_ADMIN_EMAIL="admin@myfacility.com"
# SEED_ADMIN_PASSWORD="StrongPassword123!"
# SEED_ADMIN_NAME="Site Administrator"

# ─────────────────────────────────────────────────────────
# OPTIONAL: OAuth Providers
# ─────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""

# ─────────────────────────────────────────────────────────
# OPTIONAL: File Storage (for document uploads)
# ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"

# ─────────────────────────────────────────────────────────
# SMTP Email (REQUIRED for email notifications)
# Used for: compliance alert digests, regulatory update alerts,
#           onboarding emails, and export summaries.
# Popular providers: SendGrid, Postmark, AWS SES, Resend SMTP relay
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASSWORD=<SG.xxx>
#   Postmark:  SMTP_HOST=smtp.postmarkapp.com  SMTP_PORT=587
#   AWS SES:   SMTP_HOST=email-smtp.<REGION>.amazonaws.com  SMTP_PORT=587
# ─────────────────────────────────────────────────────────
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD_OR_API_KEY"
SMTP_FROM="NyxCitadel <noreply@yourdomain.com>"
APP_URL="https://yourdomain.com"

# ─────────────────────────────────────────────────────────
# CALENDAR SYNC (iCal / Outlook / Google)
# Generate a strong random secret: openssl rand -hex 32
# Share the resulting /api/calendar/ical?token=<secret>&fid=<facilityId> URL
# with Outlook or Google Calendar as a subscription URL.
# ─────────────────────────────────────────────────────────
ICAL_SECRET="your-random-secret-here"

# ─────────────────────────────────────────────────────────
# SMS ALERTS (Twilio)
# Create a free account at https://www.twilio.com
# Users can enable SMS in Settings → Profile → SMS Alerts
# ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_NUMBER="+1XXXXXXXXXX"

# ─────────────────────────────────────────────────────────
# BILLING (Stripe) — required for live paid checkout
# Leave unset in private beta to use the 30-day trial fallback
# in /api/billing/checkout (no card charged).
# Dashboard: https://dashboard.stripe.com
# ─────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..."

# ─────────────────────────────────────────────────────────
# DEMO TOOLING (keep OFF in production)
# Enables Reset Demo Data and related demo-only admin actions.
# ─────────────────────────────────────────────────────────
# ENABLE_DEMO_TOOLS="false"

# ─────────────────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="NyxCitadel"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
