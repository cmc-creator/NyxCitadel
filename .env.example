# NyxCitadel Environment Variables
# Copy this file to .env.local and fill in your values

# ─────────────────────────────────────────────────────────
# DATABASE — Vercel Postgres (auto-populated when you add
# a Postgres database in the Vercel dashboard)
# ─────────────────────────────────────────────────────────
# Pooled connection — used by Prisma at runtime (serverless)
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/nyxcitadel?pgbouncer=true&connect_timeout=15"
# Direct connection — used by Prisma for migrations only
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/nyxcitadel"

# ─────────────────────────────────────────────────────────
# LOCAL DEV ONLY: if running Postgres locally you can set
# both vars to the same value (no pooler needed locally)
# ─────────────────────────────────────────────────────────
# POSTGRES_PRISMA_URL="postgresql://postgres:password@localhost:5432/nyxcitadel"
# POSTGRES_URL_NON_POOLING="postgresql://postgres:password@localhost:5432/nyxcitadel"

# ─────────────────────────────────────────────────────────
# NEXTAUTH
# ─────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─────────────────────────────────────────────────────────
# OPTIONAL: OAuth Providers (for SSO if desired)
# ─────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""

# ─────────────────────────────────────────────────────────
# OPTIONAL: File Storage (for documents/certificates)
# ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
# Or use: AWS_S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

# ─────────────────────────────────────────────────────────
# OPTIONAL: Email (for deadline reminders)
# ─────────────────────────────────────────────────────────
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="noreply@nyxcitadel.com"

# ─────────────────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="NyxCitadel"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
