}

enum RsReleaseReason {
  BEHAVIORAL_CRITERIA_MET
  PHYSICIAN_ORDER_EXPIRED
  PATIENT_REQUEST_GRANTED
  SAFETY_CONCERN_RESOLVED
  OTHER
}

enum RsStatus {
  OPEN        // Event in progress
  MONITORING  // Released, within monitoring window
  DEBRIEFED   // Debrief completed
  CLOSED      // All documentation complete
  REPORTED    // Reported to CMS (death or serious injury)
}

