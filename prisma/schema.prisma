// RESTRAINT & SECLUSION — CMS §482.13(e)–(f), TJC RC.02.01.01
// ─────────────────────────────────────────────────────────────────────────────

model RestraintEvent {
  id                  String           @id @default(cuid())
  facilityId          String
  facility            Facility         @relation(fields: [facilityId], references: [id])
  eventNumber         String           // e.g. "RS-2026-001"
  patientMrn          String?
  patientInitials     String
  unit                String
  eventDate           DateTime
  eventTime           String           // "14:30"
  rsType              RsType
  orderingProvider    String
  orderDateTime       DateTime
  initiatedBy         String
  clinicalJustification String         @db.Text
  behaviors           String           @db.Text  // Behavior that necessitated R/S
  lessRestrictiveTried String         @db.Text  // What was tried first
  // Monitoring (every 15 min)
  monitoringLogs      Json[]           // [{ time, staff, assessment, vitals }]
  // Physician face-to-face (required within 1 hour)
  faceToFaceTime      DateTime?
  faceToFaceBy        String?
  // Release
  releasedAt          DateTime?
  releasedBy          String?
  releaseReason       RsReleaseReason?
  durationMinutes     Int?
  // Post-event
  debrief             Boolean          @default(false)
  debriefDate         DateTime?
  debriefParticipants String[]
  debriefNotes        String?          @db.Text
  injuryOccurred      Boolean          @default(false)
  injuryDescription   String?          @db.Text
  // CMS death reporting
  deathOccurred       Boolean          @default(false)
  deathReportedToCms  Boolean          @default(false)
  deathReportDate     DateTime?
  status              RsStatus         @default(OPEN)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("restraint_events")
}

enum RsType {
  PHYSICAL_RESTRAINT
  MECHANICAL_RESTRAINT
  CHEMICAL_RESTRAINT
  SECLUSION
