  TRANSFERRED
  AMA
}

// ─────────────────────────────────────────────────────────────────────────────
// REGULATORY REFERENCE LIBRARY
// Global built-in entries seeded from src/lib/compliance/*.ts
// Facility-specific custom entries (facilityId non-null).
// ─────────────────────────────────────────────────────────────────────────────

model RegulatoryReference {
  id              String    @id @default(cuid())
  refId           String    @unique  // e.g. "cms-rs-001" or "custom-<cuid>"
  title           String
  description     String    @db.Text
  standardRef     String    // e.g. "42 CFR 482.13"
  regulatoryBody  String    // free-text: "CMS", "DEA", "AZ_ADHS", etc.
  category        String    // EventCategory value or custom string
  frequency       String    // "ANNUAL", "MONTHLY", etc.
  priority        String    // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  responsibleRole String?
  months          Int[]     // calendar months (1-12) when typically due
  notes           String?   @db.Text
  sourceUrl       String?   // link to official regulation text
  lastVerified    DateTime? // date the standard was last reviewed
  isBuiltIn       Boolean   @default(true)  // true = seeded from TS library
  facilityId      String?   // null = global; non-null = facility-specific custom
  facility        Facility? @relation(fields: [facilityId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("regulatory_references")
}

// ─────────────────────────────────────────────────────────────────────────────
// REGULATORY UPDATES
// Admin-curated feed of regulatory changes, guidance updates, and new mandates.
// Publishing an update broadcasts in-app notifications to all facility users.
// ─────────────────────────────────────────────────────────────────────────────

model RegulatoryUpdate {
  id             String        @id @default(cuid())
  title          String
  summary        String        @db.Text
  body           String?       @db.Text  // Full rich text / markdown detail
  urgency        UpdateUrgency @default(INFORMATIONAL)
  regulatoryBody String        // "CMS", "Joint Commission", "AZ ADHS", etc.
  standardRef    String?       // e.g. "42 CFR 482.13(e)(1)"
  effectiveDate  DateTime?     // When the change takes effect
  sourceUrl      String?       // Link to official rule/guidance
  isGlobal       Boolean       @default(true)  // true = applies to all facilities
  publishedById  String
  publishedBy    User          @relation("PublishedBy", fields: [publishedById], references: [id])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("regulatory_updates")
}
