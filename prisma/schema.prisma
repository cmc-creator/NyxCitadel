// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// WHITE-LABEL FACILITY CONFIGURATION
// ─────────────────────────────────────────────────────────────────────────────

model Facility {
  id              String   @id @default(cuid())
  name            String
  shortName       String?
  logoUrl         String?
  primaryColor    String   @default("#1e40af")
  secondaryColor  String   @default("#3b82f6")
  address         String?
  city            String?
  state           String   @default("AZ")
  zip             String?
  phone           String?
  fax             String?
  npi             String?  // National Provider Identifier
  medicareId      String?
  medicaidId      String?
  jcAhcId         String?  // Joint Commission accreditation ID
  licenseNumber   String?  // AZ ADHS license number
  licenseExpiry   DateTime?
  facilityType    FacilityType @default(ACUTE_PSYCH)
  bedCount        Int?
  timezone        String   @default("America/Phoenix")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  users           User[]
  complianceItems ComplianceItem[]
  calendarEvents  CalendarEvent[]
  trackerItems    TrackerItem[]
  policies        Policy[]
  incidents       Incident[]
  trainingRecords TrainingRecord[]
  drills          Drill[]
  hvaAssessments  HvaAssessment[]
  emPlans         EmergencyPlan[]
  capItems        CorrectiveActionPlan[]
  surveys         Survey[]
  documents       Document[]
  notifications   Notification[]
  riskAssessments RiskAssessment[]
  qapiMetrics     QapiMetric[]
  qapiProjects    QapiProject[]
  responseTemplates ResponseTemplate[]
  generatedResponses GeneratedResponse[]
  grievances      GrievanceRecord[]
  plansOfCorrection PlanOfCorrection[]
  rootCauseAnalyses RootCauseAnalysis[]
  qocComplaints   QocComplaint[]
  incidentReports IncidentReport[]

  @@map("facilities")
}

enum FacilityType {
  ACUTE_PSYCH
  GENERAL_ACUTE
  LTAC
  SNF
  BEHAVIORAL_HEALTH_OUTPATIENT
  CRISIS_CENTER
  RESIDENTIAL
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(STAFF)
  title         String?
  department    String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  facilityId    String
  facility      Facility  @relation(fields: [facilityId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // App relations
  assignedItems    TrackerItem[]       @relation("AssignedTo")
  createdItems     TrackerItem[]       @relation("CreatedBy")
  assignedCaps     CorrectiveActionPlan[] @relation("CAPAssignee")
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN      // Multi-facility admin (white-label root)
  ADMIN            // Facility administrator
  COMPLIANCE_OFFICER
  RISK_MANAGER
  EM_COORDINATOR   // Emergency Management Coordinator
  QUALITY          // Quality/PI staff
  EDUCATION        // Staff education/training
  STAFF            // Read + limited write
  READ_ONLY
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPLIANCE CALENDAR & EVENTS
// ─────────────────────────────────────────────────────────────────────────────

model CalendarEvent {
  id              String          @id @default(cuid())
  facilityId      String
  facility        Facility        @relation(fields: [facilityId], references: [id])
  title           String
  description     String?
  category        EventCategory
  regulatoryBody  RegulatoryBody?
  dueDate         DateTime
  completedDate   DateTime?
  status          EventStatus     @default(UPCOMING)
  isRecurring     Boolean         @default(false)
  recurrenceRule  String?         // iCal RRULE format
  parentEventId   String?         // For recurring instances
  parentEvent     CalendarEvent?  @relation("RecurringEvents", fields: [parentEventId], references: [id])
  childEvents     CalendarEvent[] @relation("RecurringEvents")
  priority        Priority        @default(MEDIUM)
  notes           String?         @db.Text
  documentUrl     String?
  remindDaysBefore Int[]          @default([90, 60, 30, 14, 7])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  trackerItem     TrackerItem?

  @@map("calendar_events")
}

enum EventCategory {
  // Emergency Management
  EM_COMMITTEE_MEETING
  HVA_ASSESSMENT
  TABLETOP_EXERCISE
  FUNCTIONAL_DRILL
  FULL_SCALE_DRILL
  EM_PLAN_REVIEW
  AFTER_ACTION_REVIEW
  COMMUNITY_PARTNER_MEETING

  // Joint Commission
  JC_SURVEY_PREP
  JC_TRACER
  JC_EC_ROUNDS
  JC_MOCK_SURVEY
  JC_STANDARDS_REVIEW
  JC_PI_MEETING

  // CMS / Conditions of Participation
  CMS_SURVEY_PREP
  CMS_MOCK_SURVEY
  CMS_QAPI_MEETING
  CMS_CONDITIONS_REVIEW

  // Arizona State (ADHS / BOMEX / etc.)
  AZ_LICENSE_RENEWAL
  AZ_ADHS_SURVEY
  AZ_INSPECTION
  AZ_REPORT_SUBMISSION
  AZ_BEHAVIORAL_HEALTH_REVIEW

  // Life Safety / Environment of Care
  FIRE_MARSHAL_INSPECTION
  LIFE_SAFETY_ROUNDS
  UTILITY_MANAGEMENT_TEST
  MEDICAL_EQUIPMENT_PM
  EOC_COMMITTEE_MEETING
  FIRE_EXTINGUISHER_INSPECTION
  SPRINKLER_INSPECTION
  FIRE_ALARM_TEST
  GENERATOR_TEST
  BACKFLOW_PREVENTER_TEST
  ELEVATOR_INSPECTION

  // Infection Control
  IC_COMMITTEE_MEETING
  IC_RISK_ASSESSMENT
  IC_SURVEILLANCE_REVIEW
  HAND_HYGIENE_AUDIT

  // Quality / PI
  QAPI_MEETING
  PEER_REVIEW
  UTILIZATION_REVIEW
  PATIENT_SATISFACTION_REVIEW
  MORTALITY_REVIEW

  // HR / Staff
  POLICY_REVIEW
  STAFF_TRAINING
  COMPETENCY_ASSESSMENT
  ANNUAL_EVALUATION
  MANDATORY_EDUCATION

  // Pharmacy / Medication
  MEDICATION_MANAGEMENT_REVIEW
  FORMULARY_REVIEW
  CONTROLLED_SUBSTANCE_AUDIT
  PHARMACY_INSPECTION

  // Patient Rights / Ethics
  PATIENT_RIGHTS_REVIEW
  ETHICS_COMMITTEE_MEETING
  INFORMED_CONSENT_AUDIT

  // Governance
  BOARD_MEETING
  MEDICAL_STAFF_MEETING
  CREDENTIALING_REVIEW
  BYLAWS_REVIEW

  OTHER
}

enum RegulatoryBody {
  JOINT_COMMISSION
  CMS
  AZ_ADHS
  AZ_BOMEX
  AZ_BON        // Board of Nursing
  AZ_BPPE       // Board of Pharmacy
  DEA
  OSHA
  EPA
  TJC_PATHWAYS  // Pathways to Excellence
  CARF
  DNV
  NCQA
  SAMHSA
  INTERNAL
  OTHER
}

enum EventStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  WAIVED
  NA
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPLIANCE ITEMS / REQUIREMENTS REGISTRY
// ─────────────────────────────────────────────────────────────────────────────

model ComplianceItem {
  id             String          @id @default(cuid())
  facilityId     String
  facility       Facility        @relation(fields: [facilityId], references: [id])
  title          String
  description    String?         @db.Text
  regulatoryBody RegulatoryBody
  standardRef    String?         // e.g., "EC.02.05.07", "42 CFR 482.41"
  category       String
  frequency      Frequency
  lastDoneDate   DateTime?
  nextDueDate    DateTime?
  status         ComplianceStatus @default(ACTIVE)
  isRequired     Boolean         @default(true)
  notes          String?         @db.Text
  evidenceUrl    String?
  responsibleRole UserRole?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("compliance_items")
}

enum ComplianceStatus {
  ACTIVE
  COMPLIANT
  NON_COMPLIANT
  PENDING_REVIEW
  WAIVED
  NA
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  BIENNIAL
  AS_NEEDED
  ONE_TIME
}

// ─────────────────────────────────────────────────────────────────────────────
// TRACKER ITEMS (Universal tracker for tasks/action items)
// ─────────────────────────────────────────────────────────────────────────────

model TrackerItem {
  id              String       @id @default(cuid())
  facilityId      String
  facility        Facility     @relation(fields: [facilityId], references: [id])
  title           String
  description     String?      @db.Text
  category        TrackerCategory
  status          TrackerStatus @default(OPEN)
  priority        Priority     @default(MEDIUM)
  dueDate         DateTime?
  completedDate   DateTime?
  assignedToId    String?
  assignedTo      User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User         @relation("CreatedBy", fields: [createdById], references: [id])
  regulatoryBody  RegulatoryBody?
  standardRef     String?
  calendarEventId String?      @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id])
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("tracker_items")
}

enum TrackerCategory {
  COMPLIANCE
  EMERGENCY_MANAGEMENT
  LIFE_SAFETY
  INFECTION_CONTROL
  QUALITY
  STAFF_EDUCATION
  POLICY
  CORRECTIVE_ACTION
  SURVEY_PREP
  OTHER
}

enum TrackerStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
  ON_HOLD
}

// ─────────────────────────────────────────────────────────────────────────────
// POLICY & PROCEDURE TRACKER
// ─────────────────────────────────────────────────────────────────────────────

model Policy {
  id              String        @id @default(cuid())
  facilityId      String
  facility        Facility      @relation(fields: [facilityId], references: [id])
  policyNumber    String
  title           String
  category        PolicyCategory
  regulatoryBody  RegulatoryBody[]
  standardRef     String?
  effectiveDate   DateTime
  nextReviewDate  DateTime
  lastReviewedDate DateTime?
  reviewFrequency Frequency     @default(ANNUAL)
  status          PolicyStatus  @default(ACTIVE)
  version         String        @default("1.0")
  owner           String?       // Department/role responsible
  documentUrl     String?
  summary         String?       @db.Text
  revisionHistory Json?         // Array of {version, date, changedBy, summary}
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("policies")
}

enum PolicyCategory {
  ADMINISTRATIVE
  CLINICAL
  EMERGENCY_MANAGEMENT
  ENVIRONMENT_OF_CARE
  HUMAN_RESOURCES
  INFECTION_CONTROL
  INFORMATION_MANAGEMENT
  LEADERSHIP
  LIFE_SAFETY
  MEDICATION_MANAGEMENT
  PATIENT_RIGHTS
  PERFORMANCE_IMPROVEMENT
  PRIVACY_SECURITY
  OTHER
}

enum PolicyStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  ARCHIVED
  OVERDUE_REVIEW
}

// ─────────────────────────────────────────────────────────────────────────────
// STAFF TRAINING & COMPETENCY TRACKER
// ─────────────────────────────────────────────────────────────────────────────

model TrainingRecord {
  id              String        @id @default(cuid())
  facilityId      String
  facility        Facility      @relation(fields: [facilityId], references: [id])
  staffName       String
  staffId         String?       // Employee ID
  department      String?
  jobTitle        String?
  trainingName    String
  category        TrainingCategory
  completedDate   DateTime?
  expiryDate      DateTime?
  isRequired      Boolean       @default(true)
  status          TrainingStatus @default(PENDING)
  score           Float?
  passingScore    Float?
  provider        String?       // Who delivered the training
  certificateUrl  String?
  notes           String?
  regulatoryBody  RegulatoryBody?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("training_records")
}

enum TrainingCategory {
  ORIENTATION
  ANNUAL_MANDATORY
  EMERGENCY_MANAGEMENT
  FIRE_SAFETY
  INFECTION_CONTROL
  CPR_BLS
  CPI_DE_ESCALATION
  SUICIDE_RISK
  RESTRAINT_SECLUSION
  MEDICATION_MANAGEMENT
  HIPAA_PRIVACY
  CLINICAL_COMPETENCY
  LEADERSHIP
  HAZMAT
  OTHER
}

enum TrainingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  OVERDUE
  EXEMPT
}

// ─────────────────────────────────────────────────────────────────────────────
// INCIDENT / OCCURRENCE TRACKER
// ─────────────────────────────────────────────────────────────────────────────

model Incident {
  id              String          @id @default(cuid())
  facilityId      String
  facility        Facility        @relation(fields: [facilityId], references: [id])
  incidentNumber  String          @unique
  dateOccurred    DateTime
  dateReported    DateTime        @default(now())
  incidentType    IncidentType
  severity        IncidentSeverity
  location        String?
  description     String          @db.Text
  immediateActions String?        @db.Text
  patientInvolved Boolean         @default(false)
  staffInvolved   Boolean         @default(false)
  rootCauseAnalysis String?       @db.Text
  correctionRequired Boolean      @default(false)
  capId           String?
  cap             CorrectiveActionPlan? @relation(fields: [capId], references: [id])
  reportableToState Boolean       @default(false)
  reportedToState Boolean         @default(false)
  stateReportDate DateTime?
  reportableToJC  Boolean         @default(false)
  jcReportDate    DateTime?
  status          IncidentStatus  @default(OPEN)
  closedDate      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("incidents")
}

enum IncidentType {
  PATIENT_FALL
  MEDICATION_ERROR
  ELOPEMENT
  ASSAULT_PATIENT_TO_STAFF
  ASSAULT_PATIENT_TO_PATIENT
  SELF_HARM
  SUICIDE_ATTEMPT
  RESTRAINT_SECLUSION
  EQUIPMENT_FAILURE
  INFECTION
  PRIVACY_BREACH
  COMPLAINT_GRIEVANCE
  SENTINEL_EVENT
  NEAR_MISS
  WORKPLACE_INJURY
  PROPERTY_DAMAGE
  SECURITY_INCIDENT
  ABUSE_NEGLECT
  OTHER
}

enum IncidentSeverity {
  MINOR         // No harm
  MODERATE      // Temporary harm
  MAJOR         // Permanent harm
  CATASTROPHIC  // Death
  SENTINEL      // Joint Commission Sentinel Event
}

enum IncidentStatus {
  OPEN
  UNDER_INVESTIGATION
  RCA_IN_PROGRESS
  CAP_IN_PROGRESS
  CLOSED
  REPORTABLE_PENDING
}

// ─────────────────────────────────────────────────────────────────────────────
// CORRECTIVE ACTION PLANS (CAPs)
// ─────────────────────────────────────────────────────────────────────────────

model CorrectiveActionPlan {
  id              String    @id @default(cuid())
  facilityId      String
  facility        Facility  @relation(fields: [facilityId], references: [id])
  capNumber       String    @unique
  title           String
  source          CapSource
  sourceRef       String?   // Incident#, survey finding#, etc.
  description     String    @db.Text
  rootCause       String?   @db.Text
  correctionPlan  String    @db.Text
  measureOfSuccess String?  @db.Text
  assigneeId      String?
  assignee        User?     @relation("CAPAssignee", fields: [assigneeId], references: [id])
  targetDate      DateTime
  completedDate   DateTime?
  status          CapStatus @default(OPEN)
  priority        Priority  @default(HIGH)
  regulatoryBody  RegulatoryBody?
  followUpDate    DateTime?
  followUpNotes   String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  incidents       Incident[]
  surveys         Survey[]

  @@map("corrective_action_plans")
}

enum CapSource {
  INTERNAL_AUDIT
  SURVEY_FINDING
  INCIDENT
  COMPLAINT
  SENTINEL_EVENT
  RISK_ASSESSMENT
  STAFF_CONCERN
  REGULATORY_REQUIREMENT
  OTHER
}

enum CapStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  OVERDUE
  EXTENDED
}

// ─────────────────────────────────────────────────────────────────────────────
// EMERGENCY MANAGEMENT MODULE
// ─────────────────────────────────────────────────────────────────────────────

model HvaAssessment {
  id              String    @id @default(cuid())
  facilityId      String
  facility        Facility  @relation(fields: [facilityId], references: [id])
  assessmentYear  Int
  completedDate   DateTime?
  reviewedBy      String?
  approvedBy      String?
  status          HvaStatus @default(IN_PROGRESS)
  totalRiskScore  Float?
  hazards         HvaHazard[]
  notes           String?   @db.Text
  documentUrl     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([facilityId, assessmentYear])
  @@map("hva_assessments")
}

enum HvaStatus {
  IN_PROGRESS
  COMPLETED
  REVIEWED
  APPROVED
}

model HvaHazard {
  id             String        @id @default(cuid())
  assessmentId   String
  assessment     HvaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  hazardName     String
  hazardType     HazardType
  probability    Int           // 0-3 scale
  magnitude      Int           // 0-3 scale
  preparedness   Int           // 0-3 scale (inverse — lower = less prepared)
  riskScore      Float         // calculated: (probability * magnitude * preparedness) / max
  mitigationPlan String?       @db.Text
  responsibleParty String?
  notes          String?

  @@map("hva_hazards")
}

enum HazardType {
  NATURAL           // Earthquake, flood, tornado, extreme heat
  TECHNOLOGICAL     // Power outage, IT failure, chemical spill
  HUMAN             // Mass casualty, active threat, civil unrest
  HAZMAT            // Chemical, biological, radiological
  INFRASTRUCTURE    // Water, HVAC, structural
}

model Drill {
  id              String      @id @default(cuid())
  facilityId      String
  facility        Facility    @relation(fields: [facilityId], references: [id])
  drillName       String
  drillType       DrillType
  scheduledDate   DateTime
  conductedDate   DateTime?
  location        String?
  scenario        String?     @db.Text
  objectives      String?     @db.Text
  participantCount Int?
  observer        String?
  status          DrillStatus @default(SCHEDULED)
  strengths       String?     @db.Text
  improvements    String?     @db.Text
  correctionsDue  DateTime?
  correctionsCompleted DateTime?
  documentUrl     String?
  regulatoryBody  RegulatoryBody?
  standardRef     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("drills")
}

enum DrillType {
  FIRE_EVACUATION
  CODE_RED
  CODE_BLUE
  CODE_GRAY         // Combative patient
  CODE_SILVER       // Active shooter/weapon
  CODE_ORANGE       // Hazmat
  CODE_PURPLE       // Child abduction
  CODE_BLACK        // Bomb threat
  UTILITY_FAILURE
  MASS_CASUALTY
  IT_DISASTER_RECOVERY
  COMMUNICATION_FAILURE
  SHELTER_IN_PLACE
  DECONTAMINATION
  TABLETOP
  FULL_SCALE
}

enum DrillStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model EmergencyPlan {
  id              String    @id @default(cuid())
  facilityId      String
  facility        Facility  @relation(fields: [facilityId], references: [id])
  planName        String
  planType        EmPlanType
  version         String    @default("1.0")
  effectiveDate   DateTime
  nextReviewDate  DateTime
  lastReviewedDate DateTime?
  approvedBy      String?
  status          PolicyStatus @default(ACTIVE)
  documentUrl     String?
  summary         String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("emergency_plans")
}

enum EmPlanType {
  EMERGENCY_OPERATIONS_PLAN
  FIRE_RESPONSE_PLAN
  EVACUATION_PLAN
  SHELTER_IN_PLACE
  ACTIVE_THREAT
  MASS_CASUALTY
  UTILITY_FAILURE
  IT_DISASTER_RECOVERY
  COMMUNICATION_PLAN
  CONTINUITY_OF_OPERATIONS
  HAZMAT_RESPONSE
  PANDEMIC_PLAN
  COMMUNITY_PARTNER_MOU
}

// ─────────────────────────────────────────────────────────────────────────────
// SURVEYS / INSPECTIONS
// ─────────────────────────────────────────────────────────────────────────────

model Survey {
  id              String    @id @default(cuid())
  facilityId      String
  facility        Facility  @relation(fields: [facilityId], references: [id])
  surveyType      SurveyType
  regulatoryBody  RegulatoryBody
  conductedDate   DateTime?
  surveyorNames   String?
  status          SurveyStatus @default(SCHEDULED)
  outcome         String?
  findingCount    Int?
  satisfactionScore Float?   // 0-100 patient satisfaction %; auto-pushes to QAPI patient_satisfaction metric
  immediateJeopardy Boolean  @default(false)
  conditionLevel  Boolean   @default(false)
  reportUrl       String?
  responseDeadline DateTime?
  responseSubmitted DateTime?
  capId               String?
  cap                 CorrectiveActionPlan? @relation(fields: [capId], references: [id])
  plansOfCorrection   PlanOfCorrection[]
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("surveys")
}

enum SurveyType {
  ACCREDITATION
  VALIDATION
  COMPLAINT
  LICENSURE
  CERTIFICATION
  FOLLOW_UP
  SELF_ASSESSMENT
  MOCK
}

enum SurveyStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  RESPONSE_DUE
  RESPONSE_SUBMITTED
  CLOSED
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id])
  name        String
  description String?
  category    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedBy  String?
  expiryDate  DateTime?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  facilityId  String
  facility    Facility         @relation(fields: [facilityId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  readAt      DateTime?
  linkUrl     String?
  createdAt   DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  DEADLINE_REMINDER
  OVERDUE_ALERT
  ASSIGNMENT
  SURVEY_ALERT
  CAP_UPDATE
  POLICY_REVIEW_DUE
  TRAINING_EXPIRING
  INCIDENT_UPDATE
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// RISK ASSESSMENTS
// JC LD.04.04.01 — annual proactive risk assessment required
// ─────────────────────────────────────────────────────────────────────────────

model RiskAssessment {
  id              String               @id @default(cuid())
  facilityId      String
  facility        Facility             @relation(fields: [facilityId], references: [id])
  title           String
  assessmentType  RiskAssessmentType
  scope           String?              // Area / department / process assessed
  conductedDate   DateTime?
  conductedBy     String?
  reviewedBy      String?
  approvedBy      String?
  status          RiskAssessmentStatus @default(IN_PROGRESS)
  summary         String?              @db.Text
  overallRiskLevel RiskLevel?
  regulatoryBody  RegulatoryBody?
  standardRef     String?
  nextReviewDate  DateTime?
  documentUrl     String?
  notes           String?              @db.Text
  items           RiskAssessmentItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("risk_assessments")
}

model RiskAssessmentItem {
  id               String         @id @default(cuid())
  assessmentId     String
  assessment       RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  riskDescription  String
  category         String?        // e.g., "Patient Safety", "Security", "Infection Control"
  likelihood       Int            // 1-5
  severity         Int            // 1-5
  riskScore        Int            // likelihood * severity (1-25)
  riskLevel        RiskLevel      // calculated
  currentControls  String?        @db.Text
  recommendedActions String?      @db.Text
  priority         Priority       @default(MEDIUM)
  assignedTo       String?
  targetDate       DateTime?
  status           RiskItemStatus @default(OPEN)
  resolvedDate     DateTime?
  notes            String?

  @@map("risk_assessment_items")
}

enum RiskAssessmentType {
  ANNUAL_PROACTIVE        // JC LD.04.04.01 annual facility-wide
  INFECTION_CONTROL       // IC.01.01.01 EP4 annual ICRA
  SECURITY                // Physical / workplace violence risk
  MEDICATION              // Medication management risk
  CLINICAL_PROCESS        // FMEA for a specific clinical process
  EMERGENCY_MANAGEMENT    // EM program risk factors
  IT_SECURITY             // HIPAA Security Risk Analysis
  ENVIRONMENT_OF_CARE     // EOC / physical environment
  CONSTRUCTION            // ICRA for construction/renovation
  OTHER
}

enum RiskAssessmentStatus {
  IN_PROGRESS
  COMPLETED
  REVIEWED
  APPROVED
  ARCHIVED
}

enum RiskLevel {
  CRITICAL    // Score 20-25
  HIGH        // Score 12-19
  MEDIUM      // Score 6-11
  LOW         // Score 1-5
}

enum RiskItemStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  ACCEPTED
  CLOSED
}

// ─────────────────────────────────────────────────────────────────────────────
// QAPI — QUALITY ASSESSMENT & PERFORMANCE IMPROVEMENT
// CMS 42 CFR 482.21 (required for CMS-certified hospitals)
// JC PI.01.01.01 / PI.02.01.01
// ─────────────────────────────────────────────────────────────────────────────

model QapiMetric {
  id           String          @id @default(cuid())
  facilityId   String
  facility     Facility        @relation(fields: [facilityId], references: [id])
  metricName   String
  metricKey    String          // machine-readable slug, e.g. "restraint_rate"
  category     QapiCategory
  month        Int             // 1-12
  year         Int
  value        Float
  target       Float?
  unit         String?         // "per 1000 pt-days", "%", "hours", etc.
  numerator    Float?
  denominator  Float?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([facilityId, metricKey, month, year])
  @@map("qapi_metrics")
}

model QapiProject {
  id              String            @id @default(cuid())
  facilityId      String
  facility        Facility          @relation(fields: [facilityId], references: [id])
  projectNumber   String            @unique
  title           String
  category        QapiCategory
  problemStatement String           @db.Text
  aim             String            @db.Text
  measure         String?           // How success will be measured
  baselineValue   Float?
  targetValue     Float?
  targetUnit      String?
  interventions   String?           @db.Text
  owner           String?
  team            String?
  startDate       DateTime
  targetDate      DateTime
  completedDate   DateTime?
  status          QapiProjectStatus @default(ACTIVE)
  outcome         String?           @db.Text
  sustainPlan     String?           @db.Text
  relatedMetricKey String?
  regulatoryBody  RegulatoryBody?
  standardRef     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("qapi_projects")
}

enum QapiCategory {
  PATIENT_SAFETY
  CLINICAL_CARE
  RESTRAINT_SECLUSION
  MEDICATION_SAFETY
  INFECTION_PREVENTION
  PATIENT_EXPERIENCE
  STAFF_SAFETY
  READMISSIONS
  THROUGHPUT
  COMPLIANCE
  WORKFORCE
  OTHER
}

enum QapiProjectStatus {
  ACTIVE
  MONITORING
  COMPLETED
  SUSPENDED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// RESPONSE TEMPLATES & QOC CORRESPONDENCE
// CMS 482.13(e) patient grievance response requirements
// JC RI.01.07.01 / AZ ADHS complaint response obligations
// ─────────────────────────────────────────────────────────────────────────────

model ResponseTemplate {
  id              String                   @id @default(cuid())
  facilityId      String
  facility        Facility                 @relation(fields: [facilityId], references: [id])
  name            String
  category        ResponseTemplateCategory
  description     String?
  subject         String?
  bodyTemplate    String                   @db.Text
  variables       String[]                 // e.g. ["{{PATIENT_NAME}}", "{{INCIDENT_DATE}}"]
  regulatoryRef   String?                  // e.g. "42 CFR 482.13(e)"
  daysRequired    Int?                     // Regulatory deadline in days (e.g. 7, 30)
  instructions    String?                  @db.Text
  isDefault       Boolean                  @default(false)  // Seeded system templates
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  responses       GeneratedResponse[]

  @@map("response_templates")
}

model GeneratedResponse {
  id              String                   @id @default(cuid())
  facilityId      String
  facility        Facility                 @relation(fields: [facilityId], references: [id])
  templateId      String?
  template        ResponseTemplate?        @relation(fields: [templateId], references: [id])
  title           String
  category        ResponseTemplateCategory
  recipientName   String?
  recipientRole   String?
  recipientAddress String?
  subject         String
  body            String                   @db.Text
  status          ResponseStatus           @default(DRAFT)
  sourceType      String?                  // "INCIDENT" | "GRIEVANCE" | "SURVEY" | "CAP"
  sourceId        String?
  sourceRef       String?                  // Human-readable ref (incident#, etc.)
  dueDate         DateTime?
  sentDate        DateTime?
  sentBy          String?
  draftedBy       String?
  reviewedBy      String?
  aiGenerated     Boolean                  @default(false)
  notes           String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@map("generated_responses")
}

enum ResponseTemplateCategory {
  PATIENT_GRIEVANCE_ACKNOWLEDGMENT     // CMS 482.13(e) — due within 7 days
  PATIENT_GRIEVANCE_RESOLUTION         // CMS 482.13(e) — due within 30 days
  SENTINEL_EVENT_FAMILY_NOTICE         // Family notification after sentinel event
  PLAN_OF_CORRECTION                   // POC to surveying agency
  CAP_COMPLETION_NOTICE                // CAP verified/closed notification
  INCIDENT_FAMILY_NOTIFICATION         // Notify family of incident
  STATE_ADVERSE_EVENT_REPORT           // AZ ADHS R9-10-211 mandatory report
  JC_SENTINEL_EVENT_REPORT             // JC sentinel event report cover
  SURVEY_RESPONSE_COVER                // General survey response cover letter
  REGULATORY_INQUIRY_RESPONSE          // Response to a regulatory inquiry/letter
  COMPLAINT_ACKNOWLEDGMENT             // Acknowledge receipt of a complaint
  PATIENT_RIGHTS_VIOLATION_RESPONSE    // AZ Mental Health Bill of Rights
  EMPLOYEE_SAFETY_INCIDENT             // Worker's comp / OSHA notification
  OTHER
}

enum ResponseStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  SENT
  FILED
}

// ─────────────────────────────────────────────────────────────────────────────
// PATIENT GRIEVANCE TRACKER
// CMS 42 CFR 482.13(e) — Joint Commission RI.01.07.01
// AZ ADHS A.A.C. R9-10-209 (patient rights / grievances)
// ─────────────────────────────────────────────────────────────────────────────

model GrievanceRecord {
  id                    String          @id @default(cuid())
  facilityId            String
  facility              Facility        @relation(fields: [facilityId], references: [id])
  grievanceNumber       String          @unique
  dateReceived          DateTime
  complainantName       String
  complainantType       ComplainantType
  complainantPhone      String?
  complainantEmail      String?
  patientName           String?
  patientDOB            DateTime?
  patientMRN            String?
  admissionDate         DateTime?
  dischargeDate         DateTime?
  summary               String          @db.Text
  category              GrievanceCategory
  severity              GrievanceSeverity @default(STANDARD)
  assignedTo            String?
  acknowledgmentDueDate DateTime        // +7 calendar days from receipt
  resolutionDueDate     DateTime        // +30 calendar days from receipt
  acknowledgmentDate    DateTime?
  acknowledgmentSentBy  String?
  resolutionDate        DateTime?
  resolutionSentBy      String?
  status                GrievanceStatus @default(OPEN)
  resolution            String?         @db.Text
  outcomeCategory       String?         // "Substantiated", "Unsubstantiated", "Partially substantiated"
  reportableToAdhs      Boolean         @default(false)
  reportedToAdhs        Boolean         @default(false)
  adshReportDate        DateTime?
  linkedIncidentId      String?
  linkedCapId           String?
  notes                 String?         @db.Text
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("grievance_records")
}

enum ComplainantType {
  PATIENT
  FAMILY_MEMBER
  GUARDIAN_CONSERVATOR
  PATIENT_ADVOCATE
  STAFF
  EXTERNAL_AGENCY
  ANONYMOUS
  OTHER
}

enum GrievanceCategory {
  CLINICAL_CARE_QUALITY       // Quality of clinical care
  MEDICATION                  // Medication-related complaint
  STAFF_CONDUCT               // Staff behavior / attitude
  PATIENT_RIGHTS              // Patient rights violation (AZ Mental Health Bill of Rights)
  RESTRAINT_SECLUSION         // Restraint/seclusion complaint
  DISCHARGE_PLANNING          // Discharge planning concerns
  FACILITY_ENVIRONMENT        // Environment, safety, cleanliness
  BILLING                     // Billing / financial
  PRIVACY_CONFIDENTIALITY     // HIPAA / privacy concern
  COMMUNICATION               // Communication with family / care team
  NEGLECT_ABUSE               // Neglect or abuse allegation
  OTHER
}

enum GrievanceSeverity {
  STANDARD          // Routine grievance
  EXPEDITED         // Clinical condition requires faster response
  REGULATORY        // Potential regulatory violation
  SENTINEL          // Linked to sentinel event or serious harm
}

enum GrievanceStatus {
  OPEN
  UNDER_REVIEW
  ACKNOWLEDGMENT_SENT
  PENDING_RESOLUTION
  RESOLVED
  ESCALATED            // Escalated to leadership / regulatory
  CLOSED
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAN OF CORRECTION (POC)
// For survey/inspection findings — CMS, JC, AZ ADHS
// ─────────────────────────────────────────────────────────────────────────────

model PlanOfCorrection {
  id              String        @id @default(cuid())
  facilityId      String
  facility        Facility      @relation(fields: [facilityId], references: [id])
  surveyId        String?
  survey          Survey?       @relation(fields: [surveyId], references: [id])
  pocNumber       String        @unique
  title           String
  regulatoryBody  RegulatoryBody
  surveyDate      DateTime?
  responseDeadline DateTime?
  submittedDate   DateTime?
  status          PocStatus     @default(DRAFT)
  findings        PocFinding[]
  coverLetter     String?       @db.Text
  certificationStatement String? @db.Text
  submittedBy     String?
  approvedBy      String?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("plans_of_correction")
}

model PocFinding {
  id                  String          @id @default(cuid())
  pocId               String
  poc                 PlanOfCorrection @relation(fields: [pocId], references: [id], onDelete: Cascade)
  findingNumber       String          // e.g., "F-Tag 689", "EC.02.05.07 EP3"
  findingDescription  String          @db.Text
  howCorrected        String?         @db.Text  // What specifically was done
  howPrevented        String?         @db.Text  // Systemic fix / policy change
  howMonitored        String?         @db.Text  // Monitoring plan / audit
  responsibleParty    String?
  targetDate          DateTime?
  completedDate       DateTime?
  evidenceOfCorrection String?        @db.Text
  status              PocFindingStatus @default(OPEN)

  @@map("poc_findings")
}

enum PocStatus {
  DRAFT
  UNDER_REVIEW
  SUBMITTED
  ACCEPTED
  REJECTED
  RESUBMIT_REQUIRED
  CLOSED
}

enum PocFindingStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

// ─────────────────────────────────────────────────────────────────────────────
// ROOT CAUSE ANALYSIS (RCA)
// JC LD.04.04.05 — Required for sentinel events and serious incidents
// ─────────────────────────────────────────────────────────────────────────────

model RootCauseAnalysis {
  id              String    @id @default(cuid())
  facilityId      String
  facility        Facility  @relation(fields: [facilityId], references: [id])
  rcaNumber       String    @unique
  eventDate       DateTime
  eventDescription String   @db.Text
  eventType       String    // e.g., "Sentinel Event", "Serious Incident"
  linkedIncidentId String?
  teamMembers     String?   @db.Text  // Names / roles of RCA team
  completedBy     String?
  approvedBy      String?
  conductedDate   DateTime?
  status          RcaStatus @default(IN_PROGRESS)

  // Timeline
  eventTimeline   String?   @db.Text  // Chronological narrative

  // Contributing factors (JC requires these categories)
  humanFactors    String?   @db.Text  // Staff performance, communication, etc.
  equipmentFactors String?  @db.Text  // Device failures
  environmentFactors String? @db.Text // Physical environment
  processFactors  String?   @db.Text  // Workflow / process breakdowns
  organizationalFactors String? @db.Text  // Leadership, culture, resources

  // 5-Whys or Fishbone
  whyAnalysis     Json?     // Array of {why: string, answer: string}

  // Root causes & actions
  rootCauses      Json?     // Array of identified root causes
  actionItems     Json?     // Array of {action, responsible, targetDate, status}

  // Outcome
  conclusion      String?   @db.Text
  preventabilityRating String?  // "Preventable", "Possibly preventable", "Not preventable"
  systemChangesRequired Boolean @default(false)
  policyChangesRequired Boolean @default(false)
  trainingRequired      Boolean @default(false)

  documentUrl     String?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("root_cause_analyses")
}

enum RcaStatus {
  IN_PROGRESS
  DRAFT_COMPLETE
  UNDER_REVIEW
  APPROVED
  SUBMITTED_TO_JC
  CLOSED
}

// Add relation to Survey for PlanOfCorrection

// ─────────────────────────────────────────────────────────────────────────────
// QOC / LOI TRACKER
// CMS 42 CFR 488 — Quality of Care Complaints & Letters of Investigation
// ─────────────────────────────────────────────────────────────────────────────

model QocComplaint {
  id                    String              @id @default(cuid())
  facilityId            String
  facility              Facility            @relation(fields: [facilityId], references: [id])
  qocNumber             String              @unique   // e.g. QOC-2026-001

  // Complaint intake
  dateReceived          DateTime
  complainantType       QocComplainantType
  cmsComplaintNumber    String?             // CMS tracking / confirm number
  stateReferenceNumber  String?             // ADHS / state reference
  allegationSummary     String              @db.Text
  allegationCategories  Json                @default("[]")

  // Letter of Investigation
  loiReceivedDate       DateTime?
  investigationType     QocInvestigationType @default(STANDARD)
  investigatorName      String?
  responseDueDate       DateTime?           // auto-calc: LOI date + 10 biz days
  responseSubmittedDate DateTime?
  surveyDate            DateTime?           // date of on-site inspection if any

  // Findings
  findingsSummary       String?             @db.Text
  deficienciesFound     Boolean             @default(false)
  citationsIssued       Json                @default("[]")

  // Assignments & links
  assignedTo            String?
  linkedGrievanceId     String?
  linkedPocId           String?
  linkedRcaId           String?

  status                QocStatus           @default(OPEN)
  closedDate            DateTime?
  notes                 String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("qoc_complaints")
}

enum QocStatus {
  OPEN
  LOI_RECEIVED
  RESPONSE_SUBMITTED
  UNDER_INVESTIGATION
  FINDINGS_ISSUED
  SUBSTANTIATED
  UNSUBSTANTIATED
  CLOSED
}

enum QocComplainantType {
  ANONYMOUS
  PATIENT
  FAMILY_MEMBER
  EMPLOYEE
  ADVOCACY_ORG
  OTHER_PROVIDER
  CMS_INITIATED
  OTHER
}

enum QocInvestigationType {
  STANDARD
  IMMEDIATE_JEOPARDY
  EXPANDED
  REVISIT
  FOLLOW_UP
}

// ─────────────────────────────────────────────────────────────────────────────
// IR / IAD TRACKER
// Incident Report & Incident/Adverse Data — ADHS, AHCCCS, JC Reporting
// ARS 36-2402, ADHS R9-10-120, AHCCCS ACOM Policy
// ─────────────────────────────────────────────────────────────────────────────

model IncidentReport {
  id                      String          @id @default(cuid())
  facilityId              String
  facility                Facility        @relation(fields: [facilityId], references: [id])
  irNumber                String          @unique   // e.g. IR-2026-001

  // Event details
  incidentDate            DateTime
  incidentTime            String?         // HH:MM
  reportedDate            DateTime        @default(now())
  incidentType            IrIncidentType
  severity                IrSeverity
  location                String?
  unitName                String?
  briefDescription        String          @db.Text
  injuryDescription       String?         @db.Text
  immediateActions        String?         @db.Text

  // Patient info
  patientName             String?
  patientMRN              String?
  patientDOB              DateTime?
  patientAge              Int?

  // Staff / witnesses
  staffInvolvedNames      String?         @db.Text
  witnessNames            String?         @db.Text

  // Notifications
  physicianNotified       Boolean         @default(false)
  physicianNotifiedTime   String?
  supervisorNotified      Boolean         @default(false)
  supervisorNotifiedTime  String?
  familyNotified          Boolean         @default(false)
  familyNotifiedDate      DateTime?

  // Regulatory reporting — ADHS
  adhsReportable          Boolean         @default(false)
  adhsReportableCategory  String?         // "24-hour", "5-day", "annual IAD"
  adhsReported            Boolean         @default(false)
  adhsReportDate          DateTime?
  adhsConfirmationNumber  String?
  adhsReportDue           DateTime?       // auto-calc deadline

  // Regulatory reporting — AHCCCS
  ahcccsReportable        Boolean         @default(false)
  ahcccsReported          Boolean         @default(false)
  ahcccsReportDate        DateTime?

  // Regulatory reporting — Joint Commission
  jcReportable            Boolean         @default(false)
  jcReported              Boolean         @default(false)
  jcReportDate            DateTime?

  // IAD submission (formal state adverse data submission)
  iadRequired             Boolean         @default(false)
  iadSubmitted            Boolean         @default(false)
  iadSubmittedDate        DateTime?
  iadPeriod               String?         // e.g. "Q1 2026"

  // Investigation
  assignedTo              String?
  investigationFindings   String?         @db.Text
  rootCauseIdentified     Boolean         @default(false)
  linkedRcaId             String?
  preventiveActions       String?         @db.Text
  linkedCapId             String?

  status                  IrStatus        @default(OPEN)
  closedDate              DateTime?
  notes                   String?         @db.Text
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@map("incident_reports")
}

enum IrStatus {
  OPEN
  INVESTIGATING
  PENDING_REVIEW
  REPORTED_TO_STATE
  CLOSED
  REOPENED
}

enum IrIncidentType {
  PATIENT_FALL
  MEDICATION_ERROR
  ELOPEMENT
  ASSAULT_PATIENT_TO_STAFF
  ASSAULT_PATIENT_TO_PATIENT
  SELF_HARM
  SUICIDE_ATTEMPT
  SUICIDE_COMPLETION
  RESTRAINT_SECLUSION_INJURY
  ABUSE_NEGLECT
  SEXUAL_ASSAULT
  EQUIPMENT_FAILURE
  INFECTION_OUTBREAK
  PRIVACY_BREACH
  WORKPLACE_INJURY
  SENTINEL_EVENT
  NEAR_MISS
  OTHER
}

enum IrSeverity {
  NEAR_MISS
  MINOR
  MODERATE
  SERIOUS
  SENTINEL
}
